NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Optional direct ECS fallback. Include /api in the URL. The backend must
# allow the frontend origin in CORS_ORIGINS and use compatible cookie settings.
NEXT_PUBLIC_ECS_API_URL=
# Public Firebase/Identity Platform web-app configuration. These values are
# safe to expose in the browser; configure provider restrictions in Google
# Cloud/Firebase and keep all token verification on the backend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
